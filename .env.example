# ======================================================================
# GuardianDrive AI — Optional Environment Configuration (.env)
# Copy this file to .env:  cp .env.example .env
# ======================================================================

# 1. Emergency Email Alert Settings (SMTP)
# For Gmail, generate a 16-character App Password in your Google Account Security settings
DMS_EMAIL_ENABLED=false
DMS_SMTP_HOST=smtp.gmail.com
DMS_SMTP_PORT=587
DMS_SMTP_USER=your_email@gmail.com
DMS_SMTP_PASSWORD=your_16_char_app_password
DMS_ALERT_RECIPIENTS=emergency_contact@example.com
DMS_EMAIL_COOLDOWN_SEC=60
DMS_EMAIL_ONLY_ON_SOS=true

# 2. Voice Alert Settings (Offline OS TTS via pyttsx3)
DMS_VOICE_ENABLED=true

# 3. GPS Tracking Settings ("simulated" or "ip")
DMS_GPS_MODE=simulated
DMS_GPS_LAT=14.4673
DMS_GPS_LON=78.8242

# 4. Optional Google Maps Platform Integration (falls back to Leaflet/OSM automatically if blank)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_ZOOM=15
